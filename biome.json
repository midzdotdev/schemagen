{
  "$schema": "https://biomejs.dev/schemas/2.4.16/schema.json",
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/node_modules",
      "!**/coverage",
      "!**/.pnpm-store",
      "!**/pnpm-lock.yaml",
      "!**/.claude",
      "!**/.vite",
      "!**/test-results",
      "!**/playwright-report",
      "!**/samples",
      "!**/styles.css"
    ]
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "performance": {
        "noDelete": "off"
      },
      "a11y": {
        "useAriaPropsSupportedByRole": "off",
        "useFocusableInteractive": "off",
        "useSemanticElements": "off",
        "noStaticElementInteractions": "off"
      },
      "style": {
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "patterns": [
              {
                "group": ["../../../**"],
                "message": "Use the @/ alias for intra-package imports (configured in tsconfig.json + vite.config.ts + vitest.config.ts). Reaching 3+ directories up means crossing a boundary that should be either same-package via @/ or cross-package via the package name (e.g. @schemagen/core)."
              }
            ]
          }
        }
      }
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "assist": { "actions": { "source": { "organizeImports": "on" } } }
}
